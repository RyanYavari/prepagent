# Copy to .env for local development. Never commit .env.
# Production values come from AWS SSM via deploy/render-env.sh (see deploy/RUNBOOK.md).

# Set to "production" on the server: enables the startup config guard, turns off
# /docs, and refuses the development JWT fallback.
# APP_ENV=production

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exact frontend origin: no trailing slash, https in production.
FRONTEND_URL=http://localhost:3000

# Random, at least 32 characters in production.
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Model used by all agents (company, interviewer, synthesis); default claude-sonnet-5-5
# AGENT_MODEL=claude-sonnet-5-5

# Cost controls and kill switches (defaults shown; see specs/deployment.md)
# MAX_BRIEFINGS_PER_USER_PER_DAY=3
# MAX_BRIEFINGS_GLOBAL_PER_DAY=20
# MAX_ACTIVE_BRIEFINGS_PER_USER=2
# SIGNUPS_ENABLED=true
# ALLOWED_EMAILS=you@example.com,friend@example.com
# BRIEFINGS_ENABLED=true
# CALENDAR_ENABLED=true

# Optional tracing. Leave unset in production: it sends resume and job description
# text to a third party.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=prepagent
